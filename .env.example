# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Public Client Configuration (Add these to Vercel Environment Variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAIL=admin@uniquerestaurant.ng
VITE_WHATSAPP_NUMBER=

# Server-Side Secrets (NEVER prefix with VITE_ or expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSCODE=
ADMIN_INITIAL_PASSWORD=
ADMIN_SESSION_SECRET=
